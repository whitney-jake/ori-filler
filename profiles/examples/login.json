{
  "id": "login",
  "name": "Login",
  "description": "Fills the login form",
  "urlPatterns": ["*testpage/index.html"],
  "delayMs": 250,
  "waitForMs": 3000,
  "fields": [
    {
      "xpath": "//form[@data-form='login']//input[@name='username']",
      "type": "text",
      "value": "tester@example.com",
      "step": 1
    },
    {
      "xpath": "//form[@data-form='login']//input[@name='password']",
      "type": "text",
      "value": "secret123",
      "step": 1
    },
    {
      "xpath": "//form[@data-form='login']//input[@name='remember']",
      "type": "checkbox",
      "value": true,
      "step": 1
    },
    {
      "xpath": "//form[@data-form='login']//fieldset[@name='role']",
      "type": "radio",
      "selectBy": "label",
      "value": "Viewer",
      "step": 1
    },
    {
      "xpath": "//form[@data-form='scenarios']//input[@name='locked']",
      "type": "text",
      "value": "cannot fill",
      "step": 2
    }
  ]
}
