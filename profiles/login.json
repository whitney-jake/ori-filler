{
  "id": "login",
  "name": "Login",
  "description": "Fills the login form",
  "urlPatterns": ["*testpage/index.html"],
  "delayMs": 250,
  "fields": [
    {
      "anchor": "//form[@data-form='login']",
      "xpath": ".//input[@name='username']",
      "type": "text",
      "value": "tester@example.com"
    },
    {
      "anchor": "//form[@data-form='login']",
      "xpath": ".//input[@name='password']",
      "type": "text",
      "value": "secret123"
    },
    {
      "anchor": "//form[@data-form='login']",
      "xpath": ".//input[@name='remember']",
      "type": "checkbox",
      "value": true
    },
    {
      "anchor": "//form[@data-form='login']",
      "xpath": ".//fieldset[@name='role']",
      "type": "radio",
      "selectBy": "label",
      "value": "Viewer"
    },
    {
      "anchor": "//form[@data-form='scenarios']",
      "xpath": ".//input[@name='locked']",
      "type": "text",
      "value": "cannot fill"
    }
  ]
}
